# This code runs on Linux (Jetson Orin Nano) even when edited on Windows.
# Force LF endings so a checkout with core.autocrlf=true can't produce a
# CRLF shell script ("/bin/bash^M: bad interpreter") when copied to the Jetson.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

# Binary artefacts that may appear later
*.pt    binary
*.pth   binary
*.onnx  binary
*.engine binary
*.pcd   binary
*.bag   binary
*.db3   binary
